# ─────────────────────────────────────────────────────────────
# DLK — variáveis de ambiente
# Copie para .env.local (local) ou cadastre na Vercel (Settings > Environment Variables).
# Variáveis NEXT_PUBLIC_* ficam visíveis no navegador: só coloque nelas dados públicos.
# ─────────────────────────────────────────────────────────────

# Endereço final do site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Contatos públicos.
# WhatsApp: só dígitos, com 55 + DDD. Se vazio, usa o padrão do código: 551153062349 = (11) 5306-2349.
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CITY=

# Redes sociais (URLs completas). Deixe vazio para não exibir.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_BEHANCE_URL=

# Recebimento de orçamentos (SÓ NO SERVIDOR — nunca use o prefixo NEXT_PUBLIC_).
# URL de um webhook que recebe POST JSON: Make, Zapier, n8n, Pipedream, Formspree, Slack (via automação), etc.
# Sem ela, o formulário avisa que o envio automático não está ativo e oferece WhatsApp/e-mail/copiar resumo.
LEADS_WEBHOOK_URL=
# Opcional: enviado no cabeçalho X-DLK-Signature, para o seu webhook conferir a origem.
LEADS_WEBHOOK_SECRET=
